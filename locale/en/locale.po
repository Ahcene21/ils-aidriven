msgstr "Enlarge cover image"

# --- Homepage layout --------------------------------------------------------

msgid "plugins.themes.ilsAiDriven.option.homepageLayout.profile"
msgstr "Journal profile: cover beside the description, then the issue"

msgid "plugins.themes.ilsAiDriven.option.submissionButton.label"
msgstr "Submission call to action"

msgid "plugins.themes.ilsAiDriven.option.submissionButton.description"
msgstr ""
"Puts a \"Make a Submission\" button at the top of the left rail on every "
"page. The rail appears for this button even when no menu is assigned to the "
"sidebar area."

msgid "plugins.themes.ilsAiDriven.option.submissionButton.enable"
msgstr "Show a submission button in the left rail"
