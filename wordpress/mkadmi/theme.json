{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "72rem"
    },
    "color": {
      "custom": true,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#0e5540",
          "name": "Green"
        },
        {
          "slug": "primary-dark",
          "color": "#0a3d2e",
          "name": "Deep green"
        },
        {
          "slug": "primary-tint",
          "color": "#eaf3ef",
          "name": "Green tint"
        },
        {
          "slug": "accent",
          "color": "#c8912b",
          "name": "Gold"
        },
        {
          "slug": "accent-light",
          "color": "#e0b45c",
          "name": "Light gold"
        },
        {
          "slug": "ink",
          "color": "#22262b",
          "name": "Ink"
        },
        {
          "slug": "muted",
          "color": "#5b6470",
          "name": "Muted"
        },
        {
          "slug": "line",
          "color": "#dde3e0",
          "name": "Rule"
        },
        {
          "slug": "surface",
          "color": "#f4f7f5",
          "name": "Surface"
        },
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "Base"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "\"Noto Naskh Arabic\", \"Amiri\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif"
        },
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "\"Noto Kufi Arabic\", Tajawal, Cairo, \"Segoe UI\", system-ui, -apple-system, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.375rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "2rem",
          "name": "Extra large"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600"
        }
      }
    }
  }
}